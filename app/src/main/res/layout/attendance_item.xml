<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/riwayat_rounded_item_background"
    android:layout_marginBottom="8dp"
    android:padding="12dp">

    <!-- Attendance Status Icon (Green/Orange/Red Clock) -->
    <ImageView
        android:id="@+id/iv_status_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="attendance_status_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Attendance Status Text (e.g., Masuk, Terlambat, Tidak Hadir) -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Masuk"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/custom_green"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iv_status_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tv_time"/>

    <!-- Attendance Date Text -->
    <TextView
        android:id="@+id/tv_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2024-01-14"
        android:textSize="12sp"
        android:textColor="@color/custom_gray"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tv_status"
        app:layout_constraintTop_toBottomOf="@id/tv_status"/>

    <!-- Attendance Time Text -->
    <TextView
        android:id="@+id/tv_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="08:00"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/custom_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
